# HomeVault environment variables
#
# NOT needed for the Stage-0 preview — the demo runs fully in the browser with
# no backend. These come into play at Stage 2 (real Supabase backend) once the
# auth + data layer is built. See DEPLOY.md and docs/ROADMAP.md.
#
# Copy to .env.local for local dev, or set in Vercel → Project → Environment
# Variables. NEVER commit real values — .env*.local is gitignored.

# --- Which DataClient backs the app ---
# "demo" (default) serves the in-memory demo household with no backend and needs
# nothing else set. "supabase" switches the data seam to the real project below,
# which also turns on sign-in: the app shell then requires an authenticated user
# and resolves the household from their membership row.
#
# Keep this unset for the public demo. Real household data must wait for the
# Phase-1 cryptographic review (docs/ROADMAP.md).
NEXT_PUBLIC_HOMEVAULT_BACKEND=

# --- Supabase (dedicated HomeVault project, separate from the business app) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by trusted server routes; never exposed to the browser.
# HomeVault is zero-knowledge, so this key can read only ciphertext + metadata.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI search / coach (only when that feature is wired) ---
ANTHROPIC_API_KEY=
