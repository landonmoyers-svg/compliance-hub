# Normalise line endings so the repo is the same on Windows and macOS.
#
# Without this, Git for Windows checks files out with CRLF and commits them
# back with CRLF, so every file Landon touches on the Windows machine shows as
# wholly rewritten in the diff and every merge conflicts on every line. The repo
# stores LF; working copies get whatever the platform wants.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.ico binary
*.woff  binary
*.woff2 binary

# Windows-only scripts must keep CRLF or PowerShell/cmd can misparse them.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
